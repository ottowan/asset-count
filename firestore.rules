rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /assets/{assetId} {
      allow read: if true;
      allow write: if false;
    }

    match /system/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /count_projects/{projectId} {
      allow read: if true;
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is string;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'name', 'targetCount', 'targetPercent', 'updatedAt'])
        && request.resource.data.status in ['open', 'closed']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.updatedAt is string
        && (!('targetCount' in request.resource.data) || (request.resource.data.targetCount is int && request.resource.data.targetCount > 0))
        && (!('targetPercent' in request.resource.data) || (request.resource.data.targetPercent is number && request.resource.data.targetPercent > 0 && request.resource.data.targetPercent <= 100));
      allow delete: if false;
    }

    match /project_data/{projectId} {
      allow read: if true;
      allow create: if exists(/databases/$(database)/documents/count_projects/$(projectId))
        && request.resource.data.assets is list
        && request.resource.data.totalAssets is int
        && request.resource.data.totalAssets == request.resource.data.assets.size()
        && request.resource.data.importedAt is string;
      allow update, delete: if false;
    }

    match /random_audits/{projectId} {
      allow read: if true;
      allow create, update: if request.resource.data.projectId == projectId
        && request.resource.data.selections is list
        && request.resource.data.generatedAt is string;
      allow delete: if true;
    }

    match /asset_counts/{assetId} {
      allow read: if true;
      allow create: if request.resource.data.assetId is string
        && request.resource.data.sn is string
        && request.resource.data.pallet is string
        && request.resource.data.condition in ['good', 'damaged']
        && request.resource.data.countedAt is string
        && ((!('projectId' in request.resource.data)
            && exists(/databases/$(database)/documents/assets/$(request.resource.data.assetId))
            && request.resource.data.sn == get(/databases/$(database)/documents/assets/$(request.resource.data.assetId)).data.sn)
          || (('projectId' in request.resource.data)
            && exists(/databases/$(database)/documents/count_projects/$(request.resource.data.projectId))
            && get(/databases/$(database)/documents/count_projects/$(request.resource.data.projectId)).data.status == 'open'))
        && (('projectId' in request.resource.data)
          || !exists(/databases/$(database)/documents/count_projects/legacy)
          || get(/databases/$(database)/documents/count_projects/legacy).data.status == 'open');
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['countedAt'])
        && request.resource.data.countedAt is string
        && (!('projectId' in resource.data)
          ? (!exists(/databases/$(database)/documents/count_projects/legacy)
            || get(/databases/$(database)/documents/count_projects/legacy).data.status == 'open')
          : get(/databases/$(database)/documents/count_projects/$(resource.data.projectId)).data.status == 'open');
      allow delete: if !('projectId' in resource.data)
        ? (!exists(/databases/$(database)/documents/count_projects/legacy)
          || get(/databases/$(database)/documents/count_projects/legacy).data.status == 'open')
        : get(/databases/$(database)/documents/count_projects/$(resource.data.projectId)).data.status == 'open';
    }
  }
}
